# Modelo de ambiente local — versionado COM as chaves e SEM valores.
# Política de Governança de Dados, seção 9.
#
# Não preencha à mão: `make env` gera um .env completo, com portas padrão e
# senhas aleatórias. Este arquivo existe para declarar quais chaves existem.

# ── Identificação ────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=

# ── Origem transacional (source_db) ──────────────────────────────────────────
# Lida pelo Airbyte em lote e pelo Debezium via WAL.
SOURCE_DB_NAME=
SOURCE_DB_USER=
SOURCE_DB_PASSWORD=
SOURCE_DB_PORT=

# ── Origem legada (legacy_db) ────────────────────────────────────────────────
# Deliberadamente defeituosa; lida por snapshot completo e imutável.
LEGACY_DB_NAME=
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=
LEGACY_DB_PORT=

# ── Armazém (warehouse_db) ───────────────────────────────────────────────────
# Destino das nove camadas do armazém.
WAREHOUSE_DB_NAME=
WAREHOUSE_DB_USER=
WAREHOUSE_DB_PASSWORD=
WAREHOUSE_DB_PORT=

# ── Airflow (Etapa 5) ────────────────────────────────────────────────────────
# Porta da interface e os dois segredos que o Airflow exige: o da assinatura
# dos tokens da API e o da criptografia das conexões guardadas no banco de
# metadados. `make env` os gera aleatórios, como as senhas dos bancos.
AIRFLOW_PORT=
AIRFLOW_JWT_SECRET=
AIRFLOW_FERNET_KEY=

# O banco de metadados do próprio Airflow. Até 20/09/2026 usuário e senha eram
# `airflow`/`airflow` escritos na composição — credencial fora do `.env`, contra
# a regra inviolável nº 1, que a varredura de segredos da Etapa 12 tornou
# visível. Interno à rede do Compose e nunca exposto, mas a regra não tem
# exceção não declarada.
AIRFLOW_DB_NAME=
AIRFLOW_DB_USER=
AIRFLOW_DB_PASSWORD=

# ── Caminho quente (Etapa 7) ─────────────────────────────────────────────────
# Portas do transporte e da API de gestão do Kafka Connect. Sem segredo: o
# conector recebe as credenciais da origem por substituição no momento de
# aplicar, e elas já estão declaradas acima.
REDPANDA_PORT=
REDPANDA_ADMIN_PORT=
KAFKA_CONNECT_PORT=
